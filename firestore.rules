rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica si el usuario autenticado tiene rol admin en Firestore
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Perfiles de usuarios ──────────────────────────────────────────────────
    match /users/{userId} {
      // Cada usuario lee/escribe su propio perfil; admin lee/escribe todos
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // ── Roles pre-asignados por correo (solo admin) ──────────────────────────
    match /email_roles/{emailKey} {
      allow read, write: if isAdmin();
    }

    // ── Historial de conversaciones ──────────────────────────────────────────
    match /conversations/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Negar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
